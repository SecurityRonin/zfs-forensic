{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": [
      "before 5am on the first day of the month"
    ]
  },
  "github-actions": {
    "pinDigests": true
  },
  "packageRules": [
    {
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "cargo deps (minor+patch)"
    },
    {
      "description": "Group fleet (SecurityRonin) crates into one PR wave.",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "/^zfs-/",
        "forensicnomicon",
        "forensic-vfs"
      ],
      "groupName": "fleet crates"
    }
  ],
  "minimumReleaseAge": "21 days",
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null,
    "labels": [
      "security"
    ],
    "prPriority": 10
  }
}
